# ============================================================
# PromptKey Float — .env 完整模板（v1）
# 使用方法：
#   1) 把这个文件复制一份，命名为 .env，放在与本文件同一目录。
#   2) 在 .env 里只填值，不要改字段名（字段名在 server/config/env.js 里有引用）。
#   3) .env 已被 .gitignore 忽略，绝不会被 Git 提交。
# 安全红线：
#   - 千万不要把填好的 .env 发给任何人（包括我），也不要截图/粘贴其中的 sk-xxx。
#   - 服务器上 .env 权限建议 600（仅 owner 可读写）。
# ============================================================


# ------------------------------------------------------------
# 1) 服务基础
# ------------------------------------------------------------
# 本地调试一般 127.0.0.1；阿里云部署时建议仍然 127.0.0.1 + Nginx 反代，
# 只在本机 Nginx 代理可达，外网无法直接打 8787。
HOST=127.0.0.1
PORT=8787


# ------------------------------------------------------------
# 2) AI 模式 & Provider
# ------------------------------------------------------------
# demo = 纯离线 Demo Provider（不需要任何 key，没接 DeepSeek 之前先用它跑通界面）。
# real = 真调用下面 AI_PROVIDER 指定的模型。
AI_MODE=demo

# real 模式下生效的 Provider 名称：目前可选 deepseek | demo
AI_PROVIDER=deepseek

# 模型名：
#   对话/文本 -> deepseek-chat
#   推理/长思考 -> deepseek-reasoner
AI_MODEL=deepseek-chat

# ========================== 必须亲自填 ==========================
# 去 https://platform.deepseek.com/api_keys 申请一个 sk- 开头的 key，
# 粘贴到下面等号右边，前后不要加引号、不要留空格。
# ================================================================
AI_API_KEY=

# DeepSeek 官方基地址。如果你要用国内中转 / OneAPI 类兼容层，改成中转的 base。
AI_BASE_URL=https://api.deepseek.com

# 单个 REFINE 请求最大等待毫秒。网络不好时可改 60000。
AI_TIMEOUT_MS=30000


# ------------------------------------------------------------
# 3) 安全基线
# ------------------------------------------------------------
# 请求体最大字节（防止超大 payload）。
BODY_LIMIT_BYTES=65536

# 单 IP 每分钟限流次数。如果你后面加了登录，可以再做成「用户级配额」。
RATE_LIMIT_PER_MIN=60

# 跨域：本地调试可写 *；上线时写你自己的域名，如 https://promptkey.ai
CORS_ORIGIN=*


# ------------------------------------------------------------
# 4) 日志
# ------------------------------------------------------------
# 是否在后端日志里打印输入内容的预览（用于调试，生产务必 false，防泄漏）。
LOG_INPUT_PREVIEW=false


# ------------------------------------------------------------
# 5) 存储 / 数据库（PHASE 3E 预留字段，env.js 暂未读取，但你现在就可以填好）
# ------------------------------------------------------------
# 可选：sqlite | postgres | redis（对应独立服务：service-storage）。
STORAGE_BACKEND=sqlite

# SQLite：相对路径或绝对路径。推荐放 deploy/data/promptkey.db
STORAGE_SQLITE_FILE=../../deploy/data/promptkey.db

# Postgres（如果以后上云数据库就填这个）。示例：
# STORAGE_PG_URL=postgresql://user:password@rm-xxx.pg.rds.aliyuncs.com:5432/promptkey
STORAGE_PG_URL=

# Redis（用于 Inbox 缓存/会话缓存，不上 RDS 就留空）。
STORAGE_REDIS_URL=


# ------------------------------------------------------------
# 6) 账号 / 鉴权（PHASE 3E+ 预留，建议上线前再开）
# ------------------------------------------------------------
# JWT 签名密钥：用一段足够长的随机串，至少 32 字节。
# 生成建议：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_JWT_TTL_SEC=604800

# 微信登录（后续加了 service-auth 就启用）。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# GitHub OAuth（后台管理登录方便）。
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=


# ------------------------------------------------------------
# 7) 阿里云部署专属
# ------------------------------------------------------------
# 域名：如果不部署就留空。填了会影响 CORS / 回调 URL。
DEPLOY_PUBLIC_DOMAIN=

# 监听网卡：ECS 上建议 127.0.0.1（前面有 Nginx 反代）；
# 如果你不想配 Nginx、想直接外网开，改成 0.0.0.0，并在阿里云安全组放行 8787。
DEPLOY_LISTEN_IP=127.0.0.1

# Node 进程数（后面想切 pm2 cluster 时用）。
DEPLOY_CLUSTER_SIZE=1

# Sentry / 阿里云 SLS 错误上报（上线推荐，出问题你能第一时间看到）。
SENTRY_DSN=
ALIYUN_SLS_ENDPOINT=
ALIYUN_SLS_PROJECT=
ALIYUN_SLS_LOGSTORE=
