# PromptKey Float — environment template (copy to .env and fill in)
# .env is git-ignored; NEVER commit real keys.

# Server
PORT=8787
HOST=127.0.0.1

# AI mode: "demo" needs no key at all; "real" uses AI_PROVIDER below
AI_MODE=demo

# Provider selection (used when AI_MODE=real): deepseek | demo
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_MS=30000

# Security baseline
BODY_LIMIT_BYTES=65536
RATE_LIMIT_PER_MIN=60
CORS_ORIGIN=*

# Logging (logs metadata only; keys/input are never logged)
LOG_INPUT_PREVIEW=false
